PORT=3000
DATABASE_URL=
NODE_ENV=development
CONTACT_EMAIL=youngdots12345@gmail.com

# Tinaab encrypts saved bank account numbers at rest.
# Use a random 32-byte key encoded as 64 hex characters or base64.
BANK_ACCOUNT_ENCRYPTION_KEY=
# Use a long random secret for HMAC account-number fingerprints.
BANK_ACCOUNT_HASH_SECRET=

# Approved payout providers. Keep blank until merchant approval,
# credentials, webhook verification, and production tests are complete.
# Supported policy values: opay, paystack
PAYOUT_PROVIDER=
OPAY_API_BASE_URL=
OPAY_MERCHANT_ID=
OPAY_API_KEY=
OPAY_SECRET_KEY=
OPAY_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=

# Keep payout execution disabled until a verified provider adapter is installed.
PAYOUT_EXECUTION_ENABLED=false
TINAAB_ADMIN_EMAILS=
